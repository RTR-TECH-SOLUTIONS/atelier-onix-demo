---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CartDrawer from "../components/CartDrawer.astro";
import "../styles/global.css";

interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const BASE = import.meta.env.BASE_URL.replace(/\/+$/, "");
---
<!doctype html>
<html lang="ro" data-base={BASE}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,300;0,400;0,500;0,600;1,400&family=Karla:wght@400;500;600;700&display=swap" />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-3 focus:bg-ink focus:text-ground focus:px-4 focus:py-2">Sari la conținut</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CartDrawer />

    <!-- WhatsApp flotant, ca la concurență -->
    <a href="https://wa.me/40722319593" aria-label="Scrie-ne pe WhatsApp"
      class="fixed bottom-5 right-5 z-30 grid place-items-center w-13 h-13 bg-jade text-white shadow-lg hover:bg-jade-deep transition-colors"
      style="width:52px;height:52px;border-radius:50%">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.87 9.87 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91C21.96 6.45 17.5 2 12.04 2Zm5.8 14.06c-.24.68-1.42 1.31-1.95 1.36-.5.05-.98.23-3.3-.69-2.77-1.09-4.53-3.92-4.67-4.1-.13-.18-1.11-1.48-1.11-2.82 0-1.34.7-2 .95-2.28.25-.27.54-.34.72-.34h.52c.17 0 .39-.6.6.46.23.5.77 1.84.84 1.97.07.14.11.3.02.48-.09.18-.13.29-.27.45l-.4.47c-.13.13-.27.28-.12.55.15.27.67 1.1 1.43 1.79.99.88 1.82 1.15 2.08 1.28.26.14.41.11.56-.07.15-.18.64-.75.81-1.01.17-.26.34-.21.57-.13.23.09 1.47.69 1.72.82.25.13.42.2.48.3.06.11.06.63-.18 1.31Z"/>
      </svg>
    </a>
  </body>
</html>
