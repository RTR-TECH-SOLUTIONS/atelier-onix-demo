---
import { CATEGORIES } from "../data/products";
const { pathname } = Astro.url;
const isActive = (href: string) => { const h = u(href); return pathname === h || (href !== "/" && pathname.startsWith(h)); };
import { u } from "../lib/url";
---

<!-- bară promo: o singură propoziție, ca la referință -->
<div class="bg-jade-deep text-[13px] leading-none">
  <div class="u-wrap flex items-center justify-center gap-2 py-2.5 text-center">
    <p class="text-surface-2/95 py-0.5">
      Transport gratuit peste 900 lei. Piesele grele se livrează cu asigurare.{" "}
      <a href={u("/livrare")} class="text-white underline underline-offset-4 decoration-white/40 hover:decoration-white">Detalii livrare</a>
    </p>
  </div>
</div>

<header id="site-header" class="sticky top-0 z-40 bg-ground border-b border-line">
  <!-- rând 1 -->
  <div class="u-wrap grid grid-cols-[auto_1fr_auto] lg:grid-cols-3 items-center gap-4 py-3 lg:py-4">

    <!-- stânga: căutare (desktop) / hamburger (mobil) -->
    <div class="flex items-center">
      <button type="button" id="nav-toggle" aria-expanded="false" aria-controls="mobile-nav"
        class="lg:hidden -ml-2 p-2 text-ink" aria-label="Deschide meniul">
        <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
          <path d="M2 5.5h18M2 11h18M2 16.5h18" stroke="currentColor" stroke-width="1.4" stroke-linecap="square"/>
        </svg>
      </button>

      <form class="hidden lg:flex items-center gap-2 border-b border-line-strong focus-within:border-ink transition-colors w-full max-w-[280px] pb-1.5" role="search" onsubmit="return false;">
        <label for="q" class="sr-only">Caută în catalog</label>
        <input id="q" name="q" type="search" placeholder="Caută în catalog..." autocomplete="off"
          class="w-full bg-transparent text-[14px] placeholder:text-ink-faint focus:outline-none" />
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="shrink-0 text-ink-soft">
          <circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1.3"/>
          <path d="M10.8 10.8 14.5 14.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="square"/>
        </svg>
      </form>
    </div>

    <!-- centru: logo -->
    <a href={u("/")} class="justify-self-center text-center group" aria-label="Atelier Onix, acasă">
      <span class="block font-[family-name:var(--font-display)] text-[17px] sm:text-[21px] lg:text-[26px] tracking-[0.12em] lg:tracking-[0.16em] uppercase leading-none whitespace-nowrap">Atelier Onix</span>
      <span class="block mt-1.5 text-[8px] sm:text-[9px] lg:text-[10px] tracking-[0.22em] lg:tracking-[0.3em] uppercase text-ink-faint whitespace-nowrap">Piatră naturală · din 2008</span>
    </a>

    <!-- dreapta: telefon, cont, coș -->
    <div class="justify-self-end flex items-center gap-1 lg:gap-3 text-ink">
      <a href="tel:+40722319593" class="hidden lg:flex items-center gap-2 pr-3 mr-1 border-r border-line text-[13px] hover:text-jade transition-colors">
        <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 2.5h2.6l1.1 3-1.4 1a8.5 8.5 0 0 0 4.2 4.2l1-1.4 3 1.1V13a.5.5 0 0 1-.5.5A11 11 0 0 1 2.5 3 .5.5 0 0 1 3 2.5Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
        </svg>
        0722 319 593
      </a>
      <a href={u("/cont")} class="p-2 hover:text-jade transition-colors" aria-label="Contul meu">
        <svg width="19" height="19" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <circle cx="10" cy="6.6" r="3.2" stroke="currentColor" stroke-width="1.3"/>
          <path d="M3.6 17c.7-3.2 3.2-5 6.4-5s5.7 1.8 6.4 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="square"/>
        </svg>
      </a>
      <button type="button" id="cart-open" class="relative p-2 hover:text-jade transition-colors" aria-label="Coșul meu">
        <svg width="19" height="19" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M3.5 5.8h13L15.3 16H4.7L3.5 5.8Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
          <path d="M7.2 8V5.2a2.8 2.8 0 1 1 5.6 0V8" stroke="currentColor" stroke-width="1.3"/>
        </svg>
        <span id="cart-count" hidden
          class="absolute -top-0.5 -right-0.5 min-w-[17px] h-[17px] px-1 grid place-items-center bg-jade text-white text-[10px] font-semibold tabular-nums rounded-full">0</span>
      </button>
    </div>
  </div>

  <!-- rând 2: navigație desktop -->
  <nav aria-label="Navigație principală" class="hidden lg:block border-t border-line">
    <ul class="u-wrap flex flex-wrap items-center justify-center gap-x-7 gap-y-1 py-3">
      {CATEGORIES.map((c) => (
        <li>
          <a href={u(`/colectie?cat=${c.slug}`)}
            class:list={["u-nav-link inline-block py-1 border-b-[1.5px] transition-colors hover:text-jade",
              isActive(`/colectie?cat=${c.slug}`) ? "border-jade text-jade" : "border-transparent"]}>{c.label}</a>
        </li>
      ))}
      <li><a href={u("/colectie")} class:list={["u-nav-link inline-block py-1 border-b-[1.5px] transition-colors hover:text-jade", pathname === "/colectie" ? "border-jade text-jade" : "border-transparent"]}>Tot catalogul</a></li>
      <li><a href={u("/cadouri-corporate")} class:list={["u-nav-link inline-block py-1 border-b-[1.5px] transition-colors hover:text-jade", isActive("/cadouri-corporate") ? "border-jade text-jade" : "border-transparent"]}>Cadouri corporate</a></li>
      <li><a href={u("/piatra")} class:list={["u-nav-link inline-block py-1 border-b-[1.5px] transition-colors hover:text-jade", isActive("/piatra") ? "border-jade text-jade" : "border-transparent"]}>Despre piatră</a></li>
    </ul>
  </nav>

  <!-- navigație mobilă -->
  <nav id="mobile-nav" hidden aria-label="Navigație mobilă" class="lg:hidden border-t border-line bg-ground">
    <form class="u-wrap py-3" role="search" onsubmit="return false;">
      <label for="q-m" class="sr-only">Caută în catalog</label>
      <input id="q-m" type="search" placeholder="Caută în catalog..."
        class="w-full bg-surface border border-line px-3 py-2.5 text-[15px] placeholder:text-ink-faint focus:outline-none focus:border-ink" style="border-radius:var(--radius-stone)" />
    </form>
    <ul class="u-wrap pb-4 flex flex-col">
      {CATEGORIES.map((c) => (
        <li><a href={u(`/colectie?cat=${c.slug}`)} class="u-nav-link block py-3 border-b border-line">{c.label}</a></li>
      ))}
      <li><a href={u("/colectie")} class="u-nav-link block py-3 border-b border-line">Tot catalogul</a></li>
      <li><a href={u("/cadouri-corporate")} class="u-nav-link block py-3 border-b border-line">Cadouri corporate</a></li>
      <li><a href={u("/piatra")} class="u-nav-link block py-3 border-b border-line">Despre piatră</a></li>
      <li><a href="tel:+40722319593" class="u-nav-link block py-3 text-jade">Sună: 0722 319 593</a></li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById("nav-toggle");
  const nav = document.getElementById("mobile-nav");
  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    toggle.setAttribute("aria-label", open ? "Deschide meniul" : "Închide meniul");
    if (nav) nav.hidden = open;
  });
</script>
