---
import Layout from "../layouts/Layout.astro";
import { u } from "../lib/url";
import { INFO } from "../data/info";

export function getStaticPaths() {
  return INFO.map((page) => ({ params: { info: page.slug }, props: { page } }));
}
const { page } = Astro.props;
---
<Layout title={`${page.title} | Atelier Onix`} description={page.lede}>
  <section class="relative border-b border-line overflow-hidden">
    <img src={u("/img/textura-onix.png")} alt="" aria-hidden="true" width="1800" height="771"
      class="absolute inset-0 w-full h-full object-cover opacity-[0.2]" />
    <div class="relative u-wrap py-10 lg:py-14 text-center">
      <nav aria-label="Firimituri" class="text-[12.5px] text-ink-soft">
        <a href={u("/")} class="hover:text-ink transition-colors">Acasă</a>
        <span class="mx-1.5 text-ink-faint">/</span><span class="text-ink">{page.title}</span>
      </nav>
      <h1 class="mt-3 text-[clamp(1.8rem,4.2vw,2.7rem)]">{page.title}</h1>
      <p class="mt-3 mx-auto max-w-[56ch] text-[15.5px] leading-relaxed text-ink-soft">{page.lede}</p>
    </div>
  </section>

  <div class="u-wrap mt-12 lg:mt-16 grid lg:grid-cols-[minmax(0,1fr)_minmax(0,280px)] gap-10 lg:gap-16 items-start">
    <div class="max-w-[66ch] flex flex-col gap-9">
      {page.draft && (
        <p class="border-l-[3px] border-brass bg-surface px-4 py-3.5 text-[14px] leading-relaxed text-ink-soft">
          Textul juridic se redactează la lansare, împreună cu clientul și cu datele reale ale firmei.
          În demo lăsăm doar structura, ca să se vadă unde intră.
        </p>
      )}
      {page.sections.map((s) => (
        <section>
          <h2 class="text-[clamp(1.2rem,2.3vw,1.6rem)]">{s.h}</h2>
          <div class="mt-3.5 flex flex-col gap-3.5 text-[16px] leading-relaxed text-ink-soft">
            {s.p.map((t) => <p>{t}</p>)}
          </div>
        </section>
      ))}

      <div class="u-vein"></div>
      <div>
        <p class="text-[15.5px] text-ink-soft max-w-[54ch]">Nu ai găsit răspunsul? Scrie-ne, răspundem în aceeași zi lucrătoare.</p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a href="https://wa.me/40722319593" class="u-btn u-btn--solid">Scrie pe WhatsApp</a>
          <a href="tel:+40722319593" class="u-btn u-btn--ghost">0722 319 593</a>
        </div>
      </div>
    </div>

    <nav aria-label="Alte informații" class="lg:sticky lg:top-[172px] border border-line bg-surface p-5" style="border-radius:var(--radius-stone)">
      <p class="u-eyebrow mb-3.5">Informații utile</p>
      <ul class="flex flex-col">
        {INFO.map((o) => (
          <li>
            <a href={u(`/${o.slug}`)}
              class:list={["block py-2.5 text-[14px] border-b border-line last:border-0 transition-colors",
                o.slug === page.slug ? "text-jade" : "hover:text-jade"]}>{o.title}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</Layout>
