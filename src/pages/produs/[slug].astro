---
import Layout from "../../layouts/Layout.astro";
import ProductCard from "../../components/ProductCard.astro";
import { PRODUCTS, CATEGORIES, lei } from "../../data/products";

export function getStaticPaths() {
  return PRODUCTS.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const cat = CATEGORIES.find((c) => c.slug === p.category)!;
const similar = PRODUCTS.filter((x) => x.category === p.category && x.slug !== p.slug).slice(0, 4);
const fallback = PRODUCTS.filter((x) => x.slug !== p.slug).slice(0, 4);
const related = similar.length >= 2 ? similar : fallback;
const gallery = p.gallery?.length ? p.gallery : [p.image, "/img/textura-onix.png", "/img/atelier.png"];
const off = p.oldPrice ? Math.round((1 - p.price / p.oldPrice) * 100) : 0;
import { u } from "../../lib/url";
---
<Layout title={`${p.name} | Atelier Onix`} description={p.short}>

  <div class="u-wrap pt-6">
    <nav aria-label="Firimituri" class="text-[12.5px] text-ink-soft">
      <a href={u("/")} class="hover:text-ink transition-colors">Acasă</a>
      <span class="mx-1.5 text-ink-faint">/</span>
      <a href={u(`/colectie?cat=${cat.slug}`)} class="hover:text-ink transition-colors">{cat.label}</a>
      <span class="mx-1.5 text-ink-faint">/</span>
      <span class="text-ink">{p.name}</span>
    </nav>
  </div>

  <div class="u-wrap mt-6 grid lg:grid-cols-[minmax(0,1.25fr)_minmax(0,1fr)] gap-8 lg:gap-14 items-start">

    <!-- galerie în mozaic, ca la referință (nu carusel) -->
    <section aria-label="Fotografii produs" class="grid grid-cols-2 gap-2.5 lg:gap-3">
      <figure class="col-span-2 relative bg-surface overflow-hidden" style="border-radius:var(--radius-stone)">
        {off > 0 && <span class="absolute top-0 left-0 z-10 bg-sale text-white text-[11px] font-semibold px-2 py-1">−{off}%</span>}
        <img src={u(gallery[0])} alt={p.name} width="1000" height="750" fetchpriority="high" decoding="async"
          class="w-full aspect-[4/3] object-cover" />
      </figure>
      {gallery.slice(1, 3).map((g, i) => (
        <figure class="bg-surface overflow-hidden" style="border-radius:var(--radius-stone)">
          <img src={u(g)} alt={i === 0 ? "Detaliu de vinișoară pe onix verde" : "Piesa în atelier, în timpul lustruirii"}
            width="500" height="500" loading="lazy" decoding="async" class="w-full aspect-square object-cover" />
        </figure>
      ))}
    </section>

    <!-- coloana de cumpărare -->
    <section class="lg:sticky lg:top-[180px]">
      <p class="u-eyebrow">{cat.label}</p>
      <h1 class="mt-3 text-[clamp(1.45rem,2.8vw,1.95rem)] leading-[1.22]">{p.name}</h1>

      <p class="mt-4 tabular-nums">
        {p.oldPrice && <span class="u-price--old text-[16px]">{lei(p.oldPrice)}</span>}
        <span class="u-price text-[26px]">{lei(p.price)}</span>
      </p>

      <p class="mt-4 text-[15.5px] leading-relaxed text-ink-soft max-w-[48ch]">{p.short}</p>

      <p class="mt-5 text-[13px] tracking-[0.08em] uppercase flex items-center gap-2">
        {p.stock === "stoc"
          ? <><span class="w-1.5 h-1.5 bg-jade rounded-full"></span><span class="text-jade">În stoc, livrare în 2-4 zile</span></>
          : <><span class="w-1.5 h-1.5 bg-brass rounded-full"></span><span class="text-brass">La comandă · {p.leadTime}</span></>}
      </p>

      <div class="mt-5 flex flex-col sm:flex-row gap-2.5">
        <button type="button" class="u-btn u-btn--solid flex-1"
          data-add-to-cart data-slug={p.slug} data-name={p.name} data-price={p.price} data-image={u(p.image)}>
          Adaugă în coș
        </button>
        <a href="https://wa.me/40722319593" class="u-btn u-btn--ghost">Întreabă despre piesă</a>
      </div>

      <div class="mt-5 pt-4 border-t border-line flex flex-wrap gap-x-6 gap-y-1.5 text-[13px] text-ink-soft">
        <p>Cod piesă: <span class="text-ink tabular-nums">AO-{p.slug.slice(0, 3).toUpperCase()}-{String(p.price).slice(0, 3)}</span></p>
        <p>Ai nevoie de ajutor? <a href="tel:+40722319593" class="text-ink hover:text-jade transition-colors">0722 319 593</a></p>
      </div>

      <!-- patru reasigurări, ca la referință -->
      <ul class="mt-6 grid grid-cols-2 gap-x-5 gap-y-4 border-t border-line pt-5">
        <li><p class="text-[13.5px] font-medium">Verificată înainte de livrare</p><p class="text-[12.5px] text-ink-soft mt-0.5">Fotografiem piesa ta reală</p></li>
        <li><p class="text-[13.5px] font-medium">Ambalare în spumă turnată</p><p class="text-[12.5px] text-ink-soft mt-0.5">Transport asigurat</p></li>
        <li><p class="text-[13.5px] font-medium">Retur în 14 zile</p><p class="text-[12.5px] text-ink-soft mt-0.5">Fără explicații</p></li>
        <li><p class="text-[13.5px] font-medium">Transport gratuit</p><p class="text-[12.5px] text-ink-soft mt-0.5">Peste 900 lei</p></li>
      </ul>
    </section>
  </div>

  <!-- taburi: descrierea lungă cerută de client -->
  <section class="u-wrap mt-14 lg:mt-20">
    <div class="border-b border-line flex flex-wrap gap-x-7" role="tablist" aria-label="Detalii produs">
      <button role="tab" id="tab-desc" aria-controls="panel-desc" aria-selected="true" class="tab u-nav-link py-3 border-b-2 border-ink -mb-px">Descriere</button>
      <button role="tab" id="tab-spec" aria-controls="panel-spec" aria-selected="false" class="tab u-nav-link py-3 border-b-2 border-transparent -mb-px text-ink-faint">Caracteristici</button>
      <button role="tab" id="tab-liv" aria-controls="panel-liv" aria-selected="false" class="tab u-nav-link py-3 border-b-2 border-transparent -mb-px text-ink-faint">Livrare și retur</button>
    </div>

    <div id="panel-desc" role="tabpanel" aria-labelledby="tab-desc" class="panel pt-7 max-w-[68ch] flex flex-col gap-4 text-[16px] leading-relaxed text-ink-soft">
      {p.description.map((d) => <p>{d}</p>)}
    </div>

    <div id="panel-spec" role="tabpanel" aria-labelledby="tab-spec" hidden class="panel pt-7 max-w-[60ch]">
      <dl class="border-t border-line">
        <div class="grid grid-cols-[minmax(0,10rem)_minmax(0,1fr)] gap-4 py-3 border-b border-line">
          <dt class="text-[13.5px] text-ink-faint">Dimensiuni</dt><dd class="text-[14.5px]">{p.dims}</dd>
        </div>
        <div class="grid grid-cols-[minmax(0,10rem)_minmax(0,1fr)] gap-4 py-3 border-b border-line">
          <dt class="text-[13.5px] text-ink-faint">Greutate</dt><dd class="text-[14.5px]">{p.weight}</dd>
        </div>
        <div class="grid grid-cols-[minmax(0,10rem)_minmax(0,1fr)] gap-4 py-3 border-b border-line">
          <dt class="text-[13.5px] text-ink-faint">Finisaj</dt><dd class="text-[14.5px]">{p.finish}</dd>
        </div>
        {p.specs.map(([k, v]) => (
          <div class="grid grid-cols-[minmax(0,10rem)_minmax(0,1fr)] gap-4 py-3 border-b border-line">
            <dt class="text-[13.5px] text-ink-faint">{k}</dt><dd class="text-[14.5px]">{v}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div id="panel-liv" role="tabpanel" aria-labelledby="tab-liv" hidden class="panel pt-7 max-w-[68ch] flex flex-col gap-4 text-[16px] leading-relaxed text-ink-soft">
      <p>Piesele sub 10 kg pleacă prin curier, în cutie cu spumă turnată după forma obiectului. Livrare în 2-4 zile lucrătoare, gratuit peste 900 lei.</p>
      <p>Piesele de mobilier se livrează cu mașina noastră sau cu transport specializat, cu asigurare inclusă pe valoarea declarată. Vă sunăm să stabilim ziua și intervalul, iar la mutarea în casă vă ajutăm doi oameni.</p>
      <p>Retur în 14 zile, fără să ne spuneți motivul. Piesa trebuie să se întoarcă în ambalajul original, iar transportul retur îl plătim noi dacă piesa a ajuns ciobită sau diferită de descriere.</p>
    </div>
  </section>

  <section class="u-wrap mt-16 lg:mt-24">
    <h2 class="text-[clamp(1.35rem,2.6vw,1.85rem)]">Piese asemănătoare</h2>
    <ul class="mt-6 grid gap-x-5 gap-y-10 grid-cols-2 lg:grid-cols-4">
      {related.map((r) => <li><ProductCard p={r} /></li>)}
    </ul>
  </section>
</Layout>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>(".tab"));
  tabs.forEach((t) => t.addEventListener("click", () => {
    tabs.forEach((o) => {
      const on = o === t;
      o.setAttribute("aria-selected", String(on));
      o.classList.toggle("border-ink", on);
      o.classList.toggle("border-transparent", !on);
      o.classList.toggle("text-ink-faint", !on);
      const panel = document.getElementById(o.getAttribute("aria-controls")!);
      if (panel) panel.hidden = !on;
    });
  }));
</script>
